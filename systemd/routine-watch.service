[Unit]
Description=Routine notifications: blocks, steps and pomodoro phases
After=graphical-session.target

[Service]
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=%h/Documents/dotfiles/scripts/routine.py watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
